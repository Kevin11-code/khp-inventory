{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KHP Steelworks Inventory",
  "version": "0.1.0",
  "identifier": "com.khp.inventory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Calculator",
        "width": 360,
        "height": 520,
        "minWidth": 360,
        "minHeight": 520,
        "maxWidth": 360,
        "maxHeight": 520,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": []
  }
}
